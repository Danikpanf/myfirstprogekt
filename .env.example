# Корень монорепо — скопируйте в apps/api/.env и apps/web/.env.local при локальной разработке

# API (apps/api/.env)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
